<UserControl
  x:Class="NMKAcad.Views.WblockView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NMKAcad;component/Views/NmkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Border
      Margin="8"
      Padding="12"
      Background="{StaticResource PanelBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Wblock" />
          <TextBlock
            Margin="0,4,0,0"
            Foreground="{StaticResource MutedTextBrush}"
            TextWrapping="Wrap"
            Text="{Binding CurrentDrawing, StringFormat=Drawing: {0}}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}" />
          <Button
            Grid.Column="1"
            MinWidth="100"
            Margin="8,0,0,0"
            Command="{Binding BrowseFolderCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="16"
                Height="16"
                Margin="0,0,6,0"
                Kind="FolderOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Browse" />
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
          <Grid Margin="0,0,0,6">
            <TextBlock Text="Name Settings" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button
                Padding="8,3"
                MinHeight="26"
                Margin="0,0,6,0"
                Command="{Binding EditCsvCommand}"
                ToolTip="Open CSV file to edit">
                <StackPanel Orientation="Horizontal">
                  <icon:MaterialIcon
                    Width="14"
                    Height="14"
                    Margin="0,0,4,0"
                    Kind="FileDocumentOutline"
                    Foreground="White" />
                  <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="12" Text="Edit CSV" />
                </StackPanel>
              </Button>
              <Button
                Padding="8,3"
                MinHeight="26"
                Command="{Binding ReloadCsvCommand}"
                ToolTip="Reload options from CSV file">
                <StackPanel Orientation="Horizontal">
                  <icon:MaterialIcon
                    Width="14"
                    Height="14"
                    Margin="0,0,4,0"
                    Kind="Refresh"
                    Foreground="White" />
                  <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="12" Text="Reload" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Prefix" />
            <ComboBox
              Width="300"
              HorizontalAlignment="Left"
              IsEditable="True"
              ItemsSource="{Binding PrefixOptions}"
              Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock Margin="0,0,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Main" />
            <ComboBox
              Width="300"
              HorizontalAlignment="Left"
              IsEditable="True"
              ItemsSource="{Binding MainOptions}"
              Text="{Binding Main, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <StackPanel HorizontalAlignment="Left">
            <DockPanel Width="300" Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource MutedTextBrush}" Text="Suffix" VerticalAlignment="Center" />
              <CheckBox
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                Content="Tự động tăng"
                IsChecked="{Binding AutoIncrementSuffix}"
                VerticalAlignment="Center"
                ToolTip="Tự động tăng giá trị suffix sau mỗi lần Wblock thành công" />
            </DockPanel>
            <ComboBox
              Width="300"
              HorizontalAlignment="Left"
              IsEditable="True"
              ItemsSource="{Binding SuffixOptions}"
              Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </StackPanel>

        <TextBlock
          Grid.Row="3"
          Margin="0,0,0,12"
          FontWeight="SemiBold"
          TextWrapping="Wrap"
          Text="{Binding CombinedName, StringFormat=File: {0}.dwg}" />

        <StackPanel Grid.Row="4" Margin="0,0,0,12" Orientation="Horizontal">
          <Button
            MinHeight="36"
            MinWidth="160"
            Margin="0,0,8,0"
            Command="{Binding WblockCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="Export"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Wblock" />
            </StackPanel>
          </Button>
          <Button
            MinHeight="36"
            MinWidth="160"
            Command="{Binding GetTextCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="FormatText"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Get Text" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBox
          Grid.Row="5"
          Style="{StaticResource StatusTextBoxStyle}"
          Text="{Binding Status, Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
