<Window
  x:Class="NMKRebar.Views.FamilySupportWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  Title="NMK Rebar — Family Support"
  Width="640"
  Height="720"
  MinWidth="520"
  MinHeight="420"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NMKRebar;component/Views/NmkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Border
      Margin="16"
      Padding="16"
      Background="{StaticResource PanelBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
          FontSize="16"
          FontWeight="SemiBold"
          Text="Family document tools" />
        <TextBlock
          Margin="0,4,0,16"
          Foreground="{StaticResource MutedTextBrush}"
          Text="Delete X/Y, make Z/Visible instance (100 each), copy nested instances, Z_1=0 and other Z=100mm." />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button
            MinWidth="180"
            MinHeight="36"
            Margin="0,0,8,0"
            Command="{Binding AddParaByCsvCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="FileDelimitedOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Add Para By CSV" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="200"
            MinHeight="36"
            Command="{Binding CopyAndAddParaCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="ContentCopy"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Copy And Add Para" />
            </StackPanel>
          </Button>
          </StackPanel>
          <Button
            MinWidth="220"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding AddArrayParaCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="Plus"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Add Array Para 6-10" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="280"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding RemoveGeneralMakeInstanceCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="Tune"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Remove General / Make Instance" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding AddXnYnCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="AxisXArrow"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Add Xn Yn / Map X Y" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding UpdateToolFamilyCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="HammerWrench"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Update Tool Family" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding UpdateChildCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="FileTree"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Update Child" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding UpdateMainCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="HomeOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Update Main" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding MapBeamCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="VectorLine"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Map Beam" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"
            Command="{Binding MapVToVisibleCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="LinkVariant"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Map V to Visible_n" />
            </StackPanel>
          </Button>
          <Button
            MinWidth="240"
            MinHeight="36"
            HorizontalAlignment="Left"
            Command="{Binding RemoveVisibleNCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="TrashCanOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Remove Visible_n" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBox
          Grid.Row="2"
          Style="{StaticResource StatusTextBoxStyle}"
          Text="{Binding Status, Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</Window>
