<Window
  x:Class="NMKRebar.Views.RebarDataWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  Title="NMK Rebar — Project"
  Width="300"
  MinWidth="300"
  MaxWidth="300"
  MaxHeight="900"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NMKRebar;component/Views/NmkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <ScrollViewer
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
      <Border
        Margin="10"
        Padding="10"
        Background="{StaticResource PanelBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <StackPanel>
          <TextBlock
            FontSize="16"
            FontWeight="SemiBold"
            Text="Project tools" />
          <TextBlock
            Margin="0,4,0,12"
            TextWrapping="Wrap"
            Foreground="{StaticResource MutedTextBrush}"
            Text="CSV folder for Set Rebar Varies." />

          <GroupBox Header="Data folder" Margin="0,0,0,8">
            <StackPanel>
              <TextBox Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}" />
              <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding BrowseFolderCommand}">
                <StackPanel Orientation="Horizontal">
                  <icon:MaterialIcon
                    Width="16"
                    Height="16"
                    Margin="0,0,6,0"
                    Kind="FolderOutline"
                    Foreground="White" />
                  <TextBlock VerticalAlignment="Center" Foreground="White" Text="Browse" />
                </StackPanel>
              </Button>
            </StackPanel>
          </GroupBox>

          <Button
            Margin="0,0,0,8"
            HorizontalAlignment="Stretch"
            Command="{Binding SetRebarVariesCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="SourceBranch"
                Foreground="White" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="White"
                TextWrapping="Wrap"
                Text="Set Rebar Varies" />
            </StackPanel>
          </Button>

          <TextBox
            Style="{StaticResource StatusTextBoxStyle}"
            Text="{Binding Status, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
</Window>
