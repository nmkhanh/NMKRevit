<Window
  x:Class="NMKRebar.Views.CreateRebarTypeWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  Title="NMK Rebar — Create Rebar Type"
  Width="500"
  MinWidth="500"
  MaxWidth="500"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NMKRebar;component/Views/NmkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Border
      Margin="10"
      Padding="10"
      Background="{StaticResource PanelBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          FontSize="16"
          FontWeight="SemiBold"
          Text="Create Rebar Type" />
        <TextBlock
          Grid.Row="1"
          Margin="0,4,0,10"
          TextWrapping="Wrap"
          Foreground="{StaticResource MutedTextBrush}"
          Text="Create RebarBarType and NMK_Rebar_Array types from Rebar.txt only." />

        <Grid Grid.Row="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox
            VerticalAlignment="Center"
            Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}" />
          <Button
            Grid.Column="1"
            Width="100"
            MinWidth="100"
            Margin="8,0,0,0"
            Command="{Binding BrowseFolderCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="16"
                Height="16"
                Margin="0,0,6,0"
                Kind="FolderOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Browse" />
            </StackPanel>
          </Button>
          <Button
            Grid.Column="2"
            Width="100"
            MinWidth="100"
            Margin="8,0,0,0"
            Command="{Binding CreateRebarTypeCommand}">
            <StackPanel Orientation="Horizontal">
              <icon:MaterialIcon
                Width="18"
                Height="18"
                Margin="0,0,8,0"
                Kind="PlusBoxOutline"
                Foreground="White" />
              <TextBlock VerticalAlignment="Center" Foreground="White" Text="Create" />
            </StackPanel>
          </Button>
        </Grid>

        <TextBox
          Grid.Row="3"
          Style="{StaticResource StatusTextBoxStyle}"
          Text="{Binding Status, Mode=OneWay}" />
      </Grid>
    </Border>
  </Grid>
</Window>
