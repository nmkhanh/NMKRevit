<Window
  x:Class="NMKRebar.Views.CheckPathWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:icon="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
  Title="NMK Rebar — Check Path"
  Width="460"
  MinWidth="460"
  MaxWidth="460"
  SizeToContent="Height"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/NMKRebar;component/Views/NmkTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PageBackgroundBrush}">
    <Border
      Margin="10"
      Padding="10"
      Background="{StaticResource PanelBrush}"
      BorderBrush="{StaticResource BorderBrush}"
      BorderThickness="1"
      CornerRadius="8">
      <StackPanel>
        <TextBlock
          FontSize="16"
          FontWeight="SemiBold"
          Text="Check Path" />
        <TextBlock
          Margin="0,4,0,10"
          TextWrapping="Wrap"
          Foreground="{StaticResource MutedTextBrush}"
          Text="Create model lines from NMK_Rebar_Array shape paths (styles 01, 02…). Does not create rebar." />
        <Button
          HorizontalAlignment="Stretch"
          Margin="0,0,0,10"
          Command="{Binding CreateModelLinesCommand}">
          <StackPanel Orientation="Horizontal">
            <icon:MaterialIcon
              Width="18"
              Height="18"
              Margin="0,0,8,0"
              Kind="VectorLine"
              Foreground="White" />
            <TextBlock VerticalAlignment="Center" Foreground="White" Text="Create Model Lines" />
          </StackPanel>
        </Button>
        <TextBox
          MinHeight="120"
          Style="{StaticResource StatusTextBoxStyle}"
          Text="{Binding Status, Mode=OneWay}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
